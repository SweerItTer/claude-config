# Config files that contain secrets — managed separately
config/claude/settings.json

# Auto-generated OMC state at repo root
.omc/

# Generated/runtime artifacts excluded from portable config ownership
/package.json
/package-lock.json
/claude/AGENTS.md

# OS files
.DS_Store
Thumbs.db
*:Zone.Identifier
.claude/
openspec/
.omc/
external/
# 统一资源计划层（script/resource-plan.py）是核心交付物，必须入库；
# 只忽略运行时/临时产物，不再用宽松的 *plan* glob 误伤合法脚本。
*.plan.tmp
*.plan.json
plan.log

# CodeGraph data files
# These are local to each machine and should not be committed

# Database
*.db
*.db-wal
*.db-shm

# Cache
cache/

# Python bytecode (tests/test-manifest-parsing.sh 用 py_compile 校验)
__pycache__/
*.pyc

# Logs
*.log

# Hook markers
.dirty

# CMake build output (tools/installer-tui)
/build/

.*/